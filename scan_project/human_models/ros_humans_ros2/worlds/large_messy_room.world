          <pose>0 0 1.0 0 0 0</pose>
          <geometry>
            <sphere>
              <radius>0.15</radius>
            </sphere>
          </geometry>
          <material>
            <ambient>1.0 0.0 0.0 1</ambient>
            <diffuse>1.0 0.0 0.0 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Moving person 5 - circular walker -->
    <model name="human_moving_5">
      <static>false</static>
      <pose>8 3 0.85 0 0 -1.0</pose>
      <link name="link">
        <inertial>
          <mass>72.0</mass>
          <inertia>
            <ixx>2</ixx>
            <iyy>2</iyy>
            <izz>0.5</izz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry>
            <cylinder>
              <radius>0.25</radius>
              <length>1.7</length>
            </cylinder>
          </geometry>
        </collision>
        <visual name="body">
          <geometry>
            <cylinder>
              <radius>0.25</radius>
              <length>1.7</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.55 0.45 0.35 1</ambient>
            <diffuse>0.6 0.5 0.4 1</diffuse>
          </material>
        </visual>
        <visual name="head">
          <pose>0 0 1.0 0 0 0</pose>
          <geometry>
            <sphere>
              <radius>0.15</radius>
            </sphere>
          </geometry>
          <material>
            <ambient>1.0 0.0 0.0 1</ambient>
            <diffuse>1.0 0.0 0.0 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ==================== TURTLEBOT3 ROVER ==================== -->
    <model name="turtlebot3_rover">
      <static>false</static>
      <pose>0 -8 0.0 0 0 1.5708</pose>
      
      <!-- Base link (chassis) -->
      <link name="base_footprint">
        <pose>0 0 0.01 0 0 0</pose>
      </link>
      
      <link name="base_link">
        <pose>0 0 0.08 0 0 0</pose>
        <inertial>
          <mass>1.5</mass>
          <inertia>
            <ixx>0.01</ixx>
            <iyy>0.01</iyy>
            <izz>0.01</izz>
          </inertia>
        </inertial>
        <collision name="base_collision">
          <geometry>
            <box>
              <size>0.28 0.18 0.08</size>
            </box>
          </geometry>
        </collision>
        <visual name="base_visual">
          <geometry>
            <box>
              <size>0.28 0.18 0.08</size>
            </box>
          </geometry>
          <material>
            <ambient>0.1 0.1 0.1 1</ambient>
            <diffuse>0.15 0.15 0.15 1</diffuse>
          </material>
        </visual>
      </link>

      <!-- Top plate -->
      <link name="top_plate">
        <pose>0 0 0.14 0 0 0</pose>
        <inertial>
          <mass>0.3</mass>
          <inertia>
            <ixx>0.002</ixx>
            <iyy>0.002</iyy>
            <izz>0.002</izz>
          </inertia>
        </inertial>
        <collision name="top_plate_collision">
          <geometry>
            <cylinder>
              <radius>0.10</radius>
              <length>0.02</length>
            </cylinder>
          </geometry>
        </collision>
        <visual name="top_plate_visual">
          <geometry>
            <cylinder>
              <radius>0.10</radius>
              <length>0.02</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.2 0.7 0.2 1</ambient>
            <diffuse>0.25 0.75 0.25 1</diffuse>
          </material>
        </visual>
      </link>

      <!-- Left wheel -->
      <link name="wheel_left">
        <pose>0 0.12 0.04 -1.5708 0 0</pose>
        <inertial>
          <mass>0.15</mass>
          <inertia>
            <ixx>0.0001</ixx>
            <iyy>0.0001</iyy>
            <izz>0.0001</izz>
          </inertia>
        </inertial>
        <collision name="wheel_left_collision">
          <geometry>
            <cylinder>
              <radius>0.04</radius>
              <length>0.025</length>
            </cylinder>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>1.0</mu>
                <mu2>1.0</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="wheel_left_visual">
          <geometry>
            <cylinder>
              <radius>0.04</radius>
              <length>0.025</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.1 0.1 0.1 1</ambient>
            <diffuse>0.15 0.15 0.15 1</diffuse>
          </material>
        </visual>
      </link>

      <!-- Right wheel -->
      <link name="wheel_right">
        <pose>0 -0.12 0.04 -1.5708 0 0</pose>
        <inertial>
          <mass>0.15</mass>
          <inertia>
            <ixx>0.0001</ixx>
            <iyy>0.0001</iyy>
            <izz>0.0001</izz>
          </inertia>
        </inertial>
        <collision name="wheel_right_collision">
          <geometry>
            <cylinder>
              <radius>0.04</radius>
              <length>0.025</length>
            </cylinder>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>1.0</mu>
                <mu2>1.0</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="wheel_right_visual">
          <geometry>
            <cylinder>
              <radius>0.04</radius>
              <length>0.025</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.1 0.1 0.1 1</ambient>
            <diffuse>0.15 0.15 0.15 1</diffuse>
          </material>
        </visual>
      </link>

      <!-- Caster wheel (front) -->
      <link name="caster_front">
        <pose>0.1 0 0.015 0 0 0</pose>
        <inertial>
          <mass>0.05</mass>
          <inertia>
            <ixx>0.00001</ixx>
            <iyy>0.00001</iyy>
            <izz>0.00001</izz>
          </inertia>
        </inertial>
        <collision name="caster_front_collision">
          <geometry>
            <sphere>
              <radius>0.015</radius>
            </sphere>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>0.0</mu>
                <mu2>0.0</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="caster_front_visual">
          <geometry>
            <sphere>
              <radius>0.015</radius>
            </sphere>
          </geometry>
          <material>
            <ambient>0.3 0.3 0.3 1</ambient>
            <diffuse>0.35 0.35 0.35 1</diffuse>
          </material>
        </visual>
      </link>

      <!-- Caster wheel (back) -->
      <link name="caster_back">
        <pose>-0.1 0 0.015 0 0 0</pose>
        <inertial>
          <mass>0.05</mass>
          <inertia>
            <ixx>0.00001</ixx>
            <iyy>0.00001</iyy>
            <izz>0.00001</izz>
          </inertia>
        </inertial>
        <collision name="caster_back_collision">
          <geometry>
            <sphere>
              <radius>0.015</radius>
            </sphere>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>0.0</mu>
                <mu2>0.0</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="caster_back_visual">
          <geometry>
            <sphere>
              <radius>0.015</radius>
            </sphere>
          </geometry>
          <material>
            <ambient>0.3 0.3 0.3 1</ambient>
            <diffuse>0.35 0.35 0.35 1</diffuse>
          </material>
        </visual>
      </link>

      <!-- LiDAR sensor mount -->
      <link name="lidar_link">
        <pose>0 0 0.18 0 0 0</pose>
        <inertial>
          <mass>0.2</mass>
          <inertia>
            <ixx>0.001</ixx>
            <iyy>0.001</iyy>
            <izz>0.001</izz>
          </inertia>
        </inertial>
        <collision name="lidar_collision">
          <geometry>
            <cylinder>
              <radius>0.04</radius>
              <length>0.04</length>
            </cylinder>
          </geometry>
        </collision>
        <visual name="lidar_visual">
          <geometry>
            <cylinder>
              <radius>0.04</radius>
              <length>0.04</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.2 0.2 0.2 1</ambient>
            <diffuse>0.25 0.25 0.25 1</diffuse>
          </material>
        </visual>
        <sensor name="lidar" type="gpu_lidar">
          <always_on>true</always_on>
          <visualize>true</visualize>
          <update_rate>10</update_rate>
          <topic>scan</topic>
          <gz_frame_id>lidar_link</gz_frame_id>
          <lidar>
            <scan>
              <horizontal>
                <samples>360</samples>
                <resolution>1</resolution>
                <min_angle>-3.14159</min_angle>
                <max_angle>3.14159</max_angle>
              </horizontal>
            </scan>
            <range>
              <min>0.12</min>
              <max>12.0</max>
              <resolution>0.01</resolution>
            </range>
            <noise>
              <type>gaussian</type>
              <mean>0.0</mean>
              <stddev>0.01</stddev>
            </noise>
          </lidar>
        </sensor>
      </link>

      <!-- 360-degree Camera mount -->
      <link name="camera_link">
        <pose>0 0 0.22 0 0 0</pose>
        <inertial>
          <mass>0.1</mass>
          <inertia>
            <ixx>0.0001</ixx>
            <iyy>0.0001</iyy>
            <izz>0.0001</izz>
          </inertia>
        </inertial>
        <collision name="camera_collision">
          <geometry>
            <sphere>
              <radius>0.02</radius>
            </sphere>
          </geometry>
        </collision>
        <visual name="camera_visual">
          <geometry>
            <sphere>
              <radius>0.02</radius>
            </sphere>
          </geometry>
          <material>
            <ambient>0.1 0.1 0.8 1</ambient>
            <diffuse>0.15 0.15 0.85 1</diffuse>
          </material>
        </visual>
        <!-- Front camera -->
        <sensor name="camera_front" type="camera">
          <always_on>true</always_on>
          <update_rate>15</update_rate>
          <topic>camera/front/image</topic>
          <camera>
            <horizontal_fov>1.57</horizontal_fov>
            <image>
              <width>640</width>
              <height>480</height>
              <format>R8G8B8</format>
            </image>
            <clip>
              <near>0.1</near>
              <far>15.0</far>
            </clip>
          </camera>
        </sensor>
        <!-- Right camera -->
        <sensor name="camera_right" type="camera">
          <pose>0 0 0 0 0 -1.5708</pose>
          <always_on>true</always_on>
          <update_rate>15</update_rate>
          <topic>camera/right/image</topic>
          <camera>
            <horizontal_fov>1.57</horizontal_fov>
            <image>
              <width>640</width>
              <height>480</height>
              <format>R8G8B8</format>
            </image>
            <clip>
              <near>0.1</near>
              <far>15.0</far>
            </clip>
          </camera>
        </sensor>
        <!-- Back camera -->
        <sensor name="camera_back" type="camera">
          <pose>0 0 0 0 0 3.14159</pose>
          <always_on>true</always_on>
          <update_rate>15</update_rate>
          <topic>camera/back/image</topic>
          <camera>
            <horizontal_fov>1.57</horizontal_fov>
            <image>
              <width>640</width>
              <height>480</height>
              <format>R8G8B8</format>
            </image>
            <clip>
              <near>0.1</near>
              <far>15.0</far>
            </clip>
          </camera>
        </sensor>
        <!-- Left camera -->
        <sensor name="camera_left" type="camera">
          <pose>0 0 0 0 0 1.5708</pose>
          <always_on>true</always_on>
          <update_rate>15</update_rate>
          <topic>camera/left/image</topic>
          <camera>
            <horizontal_fov>1.57</horizontal_fov>
            <image>
              <width>640</width>
              <height>480</height>
              <format>R8G8B8</format>
            </image>
            <clip>
              <near>0.1</near>
              <far>15.0</far>
            </clip>
          </camera>
        </sensor>
      </link>

      <!-- Joints -->
      <joint name="base_joint" type="fixed">
        <parent>base_footprint</parent>
        <child>base_link</child>
      </joint>

      <joint name="top_plate_joint" type="fixed">
        <parent>base_link</parent>
        <child>top_plate</child>
      </joint>

      <joint name="wheel_left_joint" type="revolute">
        <parent>base_link</parent>
        <child>wheel_left</child>
        <axis>
          <xyz>0 0 1</xyz>
          <limit>
            <lower>-1e16</lower>
            <upper>1e16</upper>
          </limit>
        </axis>
      </joint>

      <joint name="wheel_right_joint" type="revolute">
        <parent>base_link</parent>
        <child>wheel_right</child>
        <axis>
          <xyz>0 0 1</xyz>
          <limit>
            <lower>-1e16</lower>
            <upper>1e16</upper>
          </limit>
        </axis>
      </joint>

      <joint name="caster_front_joint" type="ball">
        <parent>base_link</parent>
        <child>caster_front</child>
      </joint>

      <joint name="caster_back_joint" type="ball">
        <parent>base_link</parent>
        <child>caster_back</child>
      </joint>

      <joint name="lidar_joint" type="fixed">
        <parent>top_plate</parent>
        <child>lidar_link</child>
      </joint>

      <joint name="camera_joint" type="fixed">
        <parent>lidar_link</parent>
        <child>camera_link</child>
      </joint>

      <!-- Differential drive plugin for Gazebo Sim -->
      <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
        <left_joint>wheel_left_joint</left_joint>
        <right_joint>wheel_right_joint</right_joint>
        <wheel_separation>0.24</wheel_separation>
        <wheel_radius>0.04</wheel_radius>
        <max_linear_acceleration>1.0</max_linear_acceleration>
        <topic>cmd_vel</topic>
        <odom_topic>odom</odom_topic>
        <frame_id>odom</frame_id>
        <child_frame_id>base_footprint</child_frame_id>
        <odom_publish_frequency>30</odom_publish_frequency>
      </plugin>
    </model>

    <!-- ==================== ADDITIONAL FURNITURE/OBSTACLES ==================== -->

    <!-- Bookshelf -->
    <model name="bookshelf">
      <static>true</static>
      <pose>11 0 0 0 0 0</pose>
      <link name="frame">
        <pose>0 0 1.0 0 0 0</pose>
        <collision name="collision">
          <geometry>
            <box><size>0.4 1.5 2.0</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>0.4 1.5 2.0</size></box>
          </geometry>
          <material>
            <ambient>0.45 0.3 0.18 1</ambient>
            <diffuse>0.5 0.35 0.23 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Pillar 1 -->
    <model name="pillar_1">
      <static>true</static>
      <link name="link">
        <pose>-4 8 1.5 0 0 0</pose>
        <collision name="collision">
          <geometry>
            <cylinder>
              <radius>0.4</radius>
              <length>3</length>
            </cylinder>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <cylinder>
              <radius>0.4</radius>
              <length>3</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.6 0.6 0.55 1</ambient>
            <diffuse>0.65 0.65 0.6 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Pillar 2 -->
    <model name="pillar_2">
      <static>true</static>
      <link name="link">
        <pose>4 -4 1.5 0 0 0</pose>
        <collision name="collision">
          <geometry>
            <cylinder>
              <radius>0.4</radius>
              <length>3</length>
            </cylinder>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <cylinder>
              <radius>0.4</radius>
              <length>3</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.6 0.6 0.55 1</ambient>
            <diffuse>0.65 0.65 0.6 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
