<?xml version="1.0" ?>
<!--
  Test Scenario 1: Corridor Blocked
  ==================================
  A straight 10m x 3m corridor. One stationary human stands in the middle,
  blocking the direct path. The robot must detect the human and replan
  around them (squeeze past on one side).

  Robot spawns at (-4, 0) facing +X.
  Goal at (4, 0).
  Human stands at (0, 0) — dead center of the corridor.
-->
<sdf version="1.6">
  <world name="test_corridor_blocked">
    <!-- Required plugins -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>

    <scene>
      <ambient>0.6 0.6 0.6 1</ambient>
      <background>0.3 0.3 0.4 1</background>
    </scene>

    <light name="light_1" type="point">
      <pose>0 0 4 0 0 0</pose>
      <diffuse>0.9 0.9 0.8 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <attenuation><range>20</range><constant>0.3</constant><linear>0.01</linear><quadratic>0.001</quadratic></attenuation>
    </light>

    <physics type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <!-- ==================== FLOOR ==================== -->
    <model name="floor">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
          <material><ambient>0.4 0.35 0.3 1</ambient><diffuse>0.45 0.4 0.35 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ==================== CORRIDOR WALLS ==================== -->
    <!-- North wall (long) -->
    <model name="wall_north">
      <static>true</static>
      <link name="link">
        <pose>0 1.5 1.5 0 0 0</pose>
        <collision name="collision"><geometry><box><size>10 0.2 3</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>10 0.2 3</size></box></geometry>
          <material><ambient>0.7 0.65 0.6 1</ambient><diffuse>0.75 0.7 0.65 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- South wall (long) -->
    <model name="wall_south">
      <static>true</static>
      <link name="link">
        <pose>0 -1.5 1.5 0 0 0</pose>
        <collision name="collision"><geometry><box><size>10 0.2 3</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>10 0.2 3</size></box></geometry>
          <material><ambient>0.7 0.65 0.6 1</ambient><diffuse>0.75 0.7 0.65 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- West wall (end cap) -->
    <model name="wall_west">
      <static>true</static>
      <link name="link">
        <pose>-5 0 1.5 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.2 3 3</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.2 3 3</size></box></geometry>
          <material><ambient>0.7 0.65 0.6 1</ambient><diffuse>0.75 0.7 0.65 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- East wall (end cap) -->
    <model name="wall_east">
      <static>true</static>
      <link name="link">
        <pose>5 0 1.5 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.2 3 3</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.2 3 3</size></box></geometry>
          <material><ambient>0.7 0.65 0.6 1</ambient><diffuse>0.75 0.7 0.65 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ==================== STATIONARY HUMAN (blocking center) ==================== -->
    <model name="human_static_1">
      <static>true</static>
      <pose>0 0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>0.25</radius><length>1.0</length></cylinder></geometry>
        </collision>
        <visual name="body">
          <geometry><cylinder><radius>0.25</radius><length>1.0</length></cylinder></geometry>
          <material><ambient>0.55 0.45 0.35 1</ambient><diffuse>0.6 0.5 0.4 1</diffuse></material>
        </visual>
        <visual name="head">
          <pose>0 0 0.75 0 0 0</pose>
          <geometry><sphere><radius>0.25</radius></sphere></geometry>
          <material><ambient>1.0 0.0 0.0 1</ambient><diffuse>1.0 0.0 0.0 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ==================== TURTLEBOT3 ROVER ==================== -->
    <model name="turtlebot3_rover">
      <static>false</static>
      <pose>-4 0 0.0 0 0 0</pose>
      
      <link name="base_footprint"><pose>0 0 0.01 0 0 0</pose></link>
      
      <link name="base_link">
        <pose>0 0 0.08 0 0 0</pose>
        <inertial><mass>1.5</mass><inertia><ixx>0.01</ixx><iyy>0.01</iyy><izz>0.01</izz></inertia></inertial>
        <collision name="base_collision"><geometry><box><size>0.28 0.18 0.08</size></box></geometry></collision>
        <visual name="base_visual">
          <geometry><box><size>0.28 0.18 0.08</size></box></geometry>
          <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.15 0.15 0.15 1</diffuse></material>
        </visual>
      </link>

      <link name="top_plate">
        <pose>0 0 0.14 0 0 0</pose>
        <inertial><mass>0.3</mass><inertia><ixx>0.002</ixx><iyy>0.002</iyy><izz>0.002</izz></inertia></inertial>
        <collision name="top_plate_collision"><geometry><cylinder><radius>0.10</radius><length>0.02</length></cylinder></geometry></collision>
        <visual name="top_plate_visual">
          <geometry><cylinder><radius>0.10</radius><length>0.02</length></cylinder></geometry>
          <material><ambient>0.2 0.7 0.2 1</ambient><diffuse>0.25 0.75 0.25 1</diffuse></material>
        </visual>
      </link>

      <link name="wheel_left">
        <pose>0 0.12 0.04 -1.5708 0 0</pose>
        <inertial><mass>0.15</mass><inertia><ixx>0.0001</ixx><iyy>0.0001</iyy><izz>0.0001</izz></inertia></inertial>
        <collision name="wheel_left_collision">
          <geometry><cylinder><radius>0.04</radius><length>0.025</length></cylinder></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
        </collision>
        <visual name="wheel_left_visual">
          <geometry><cylinder><radius>0.04</radius><length>0.025</length></cylinder></geometry>
          <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.15 0.15 0.15 1</diffuse></material>
        </visual>
      </link>

      <link name="wheel_right">
        <pose>0 -0.12 0.04 -1.5708 0 0</pose>
        <inertial><mass>0.15</mass><inertia><ixx>0.0001</ixx><iyy>0.0001</iyy><izz>0.0001</izz></inertia></inertial>
        <collision name="wheel_right_collision">
          <geometry><cylinder><radius>0.04</radius><length>0.025</length></cylinder></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
        </collision>
        <visual name="wheel_right_visual">
          <geometry><cylinder><radius>0.04</radius><length>0.025</length></cylinder></geometry>
          <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.15 0.15 0.15 1</diffuse></material>
        </visual>
      </link>

      <link name="caster_front">
        <pose>0.1 0 0.015 0 0 0</pose>
        <inertial><mass>0.05</mass><inertia><ixx>0.00001</ixx><iyy>0.00001</iyy><izz>0.00001</izz></inertia></inertial>
        <collision name="caster_front_collision">
          <geometry><sphere><radius>0.015</radius></sphere></geometry>
          <surface><friction><ode><mu>0.0</mu><mu2>0.0</mu2></ode></friction></surface>
        </collision>
        <visual name="caster_front_visual">
          <geometry><sphere><radius>0.015</radius></sphere></geometry>
          <material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.35 0.35 0.35 1</diffuse></material>
        </visual>
      </link>

      <link name="caster_back">
        <pose>-0.1 0 0.015 0 0 0</pose>
        <inertial><mass>0.05</mass><inertia><ixx>0.00001</ixx><iyy>0.00001</iyy><izz>0.00001</izz></inertia></inertial>
        <collision name="caster_back_collision">
          <geometry><sphere><radius>0.015</radius></sphere></geometry>
          <surface><friction><ode><mu>0.0</mu><mu2>0.0</mu2></ode></friction></surface>
        </collision>
        <visual name="caster_back_visual">
          <geometry><sphere><radius>0.015</radius></sphere></geometry>
          <material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.35 0.35 0.35 1</diffuse></material>
        </visual>
      </link>

      <link name="lidar_link">
        <pose>0 0 0.18 0 0 0</pose>
        <inertial><mass>0.2</mass><inertia><ixx>0.001</ixx><iyy>0.001</iyy><izz>0.001</izz></inertia></inertial>
        <collision name="lidar_collision"><geometry><cylinder><radius>0.04</radius><length>0.04</length></cylinder></geometry></collision>
        <visual name="lidar_visual">
          <geometry><cylinder><radius>0.04</radius><length>0.04</length></cylinder></geometry>
          <material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.25 0.25 0.25 1</diffuse></material>
        </visual>
        <sensor name="lidar" type="gpu_lidar">
          <always_on>true</always_on><visualize>true</visualize><update_rate>10</update_rate>
          <topic>scan</topic><gz_frame_id>lidar_link</gz_frame_id>
          <lidar><scan><horizontal><samples>360</samples><resolution>1</resolution><min_angle>-3.14159</min_angle><max_angle>3.14159</max_angle></horizontal></scan>
          <range><min>0.12</min><max>12.0</max><resolution>0.01</resolution></range>
          <noise><type>gaussian</type><mean>0.0</mean><stddev>0.01</stddev></noise></lidar>
        </sensor>
      </link>

      <link name="camera_link">
        <pose>0 0 0.22 0 0 0</pose>
        <inertial><mass>0.1</mass><inertia><ixx>0.0001</ixx><iyy>0.0001</iyy><izz>0.0001</izz></inertia></inertial>
        <collision name="camera_collision"><geometry><sphere><radius>0.02</radius></sphere></geometry></collision>
        <visual name="camera_visual">
          <geometry><sphere><radius>0.02</radius></sphere></geometry>
          <material><ambient>0.1 0.1 0.8 1</ambient><diffuse>0.15 0.15 0.85 1</diffuse></material>
        </visual>
        <sensor name="camera_front" type="camera">
          <always_on>true</always_on><update_rate>15</update_rate><topic>camera/front/image</topic>
          <camera><horizontal_fov>1.57</horizontal_fov><image><width>640</width><height>480</height><format>R8G8B8</format></image><clip><near>0.1</near><far>15.0</far></clip></camera>
        </sensor>
        <sensor name="camera_right" type="camera">
          <pose>0 0 0 0 0 -1.5708</pose>
          <always_on>true</always_on><update_rate>15</update_rate><topic>camera/right/image</topic>
          <camera><horizontal_fov>1.57</horizontal_fov><image><width>640</width><height>480</height><format>R8G8B8</format></image><clip><near>0.1</near><far>15.0</far></clip></camera>
        </sensor>
        <sensor name="camera_back" type="camera">
          <pose>0 0 0 0 0 3.14159</pose>
          <always_on>true</always_on><update_rate>15</update_rate><topic>camera/back/image</topic>
          <camera><horizontal_fov>1.57</horizontal_fov><image><width>640</width><height>480</height><format>R8G8B8</format></image><clip><near>0.1</near><far>15.0</far></clip></camera>
        </sensor>
        <sensor name="camera_left" type="camera">
          <pose>0 0 0 0 0 1.5708</pose>
          <always_on>true</always_on><update_rate>15</update_rate><topic>camera/left/image</topic>
          <camera><horizontal_fov>1.57</horizontal_fov><image><width>640</width><height>480</height><format>R8G8B8</format></image><clip><near>0.1</near><far>15.0</far></clip></camera>
        </sensor>
      </link>

      <joint name="base_joint" type="fixed"><parent>base_footprint</parent><child>base_link</child></joint>
      <joint name="top_plate_joint" type="fixed"><parent>base_link</parent><child>top_plate</child></joint>
      <joint name="wheel_left_joint" type="revolute"><parent>base_link</parent><child>wheel_left</child><axis><xyz>0 0 1</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis></joint>
      <joint name="wheel_right_joint" type="revolute"><parent>base_link</parent><child>wheel_right</child><axis><xyz>0 0 1</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis></joint>
      <joint name="caster_front_joint" type="ball"><parent>base_link</parent><child>caster_front</child></joint>
      <joint name="caster_back_joint" type="ball"><parent>base_link</parent><child>caster_back</child></joint>
      <joint name="lidar_joint" type="fixed"><parent>top_plate</parent><child>lidar_link</child></joint>
      <joint name="camera_joint" type="fixed"><parent>lidar_link</parent><child>camera_link</child></joint>

      <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
        <left_joint>wheel_left_joint</left_joint><right_joint>wheel_right_joint</right_joint>
        <wheel_separation>0.24</wheel_separation><wheel_radius>0.04</wheel_radius>
        <max_linear_acceleration>1.0</max_linear_acceleration>
        <topic>cmd_vel</topic><odom_topic>odom</odom_topic>
        <frame_id>odom</frame_id><child_frame_id>base_footprint</child_frame_id>
        <odom_publish_frequency>30</odom_publish_frequency>
      </plugin>
    </model>

  </world>
</sdf>
